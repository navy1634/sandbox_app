FROM golang:1.26-bookworm AS builder
WORKDIR /app
COPY go.mod go.sum* ./
RUN go mod download
RUN go build -o /app/bin/goose github.com/pressly/goose/v3/cmd/goose

FROM debian:bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/bin/goose /app/goose
COPY migrations /app/migrations
ENTRYPOINT ["/app/goose", "-dir", "/app/migrations"]
CMD ["postgres", "postgres://postgres:password@db:5432/test?sslmode=disable", "up"]
